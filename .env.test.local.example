# Local Supabase API URL (run `supabase status` after `supabase start`)
SUPABASE_URL=http://127.0.0.1:54321

# Local Supabase anon/publishable key (run `supabase status` for the current value —
# do not hardcode a guessed format here; newer Supabase CLI versions issue
# sb_publishable_... keys rather than legacy JWT anon keys)
SUPABASE_ANON_KEY=
